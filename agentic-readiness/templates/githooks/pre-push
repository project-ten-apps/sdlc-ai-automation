#!/bin/sh
# Runs the quality gate before every push, for agents and humans alike.
# Install (shared): commit as .githooks/pre-push, then once per clone: git config core.hooksPath .githooks
# Install (local only): copy to .git/hooks/pre-push (applies to every worktree of the clone).
# Git for Windows runs this with its own sh; call ./gradlew, not gradlew.bat.

# Pushes that only delete refs have nothing to check.
has_update=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) has_update=1 ;;
  esac
done
[ "$has_update" -eq 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)" || exit 1

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: uncommitted changes; the gate checks the working tree, not only the pushed commits." >&2
fi

echo "pre-push: running {{CMD_GATE}}" >&2
if ! {{CMD_GATE}}; then
  echo "pre-push: quality gate failed, push blocked. Fix the failures or ask the developer." >&2
  exit 1
fi
