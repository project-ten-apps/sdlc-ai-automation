#!/bin/sh
# Runs the quality gate before every push, for agents and humans alike.
# Install (shared): commit as .githooks/pre-push, then once per clone: git config core.hooksPath .githooks
# Install (local only): copy to .git/hooks/pre-push (applies to every worktree of the clone).
# Git for Windows runs this with its own sh; call ./gradlew, not gradlew.bat.
#
# The gate runs on the checkout, so the hook only accepts pushes whose commits are exactly
# the checked-out HEAD on a clean tree. Push other branches from their own worktree.

cd "$(git rev-parse --show-toplevel)" || exit 1
head_sha=$(git rev-parse HEAD) || exit 1

has_update=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;  # deleting a remote ref: nothing to check
  esac
  has_update=1
  pushed=$(git rev-parse "$local_sha^{commit}" 2>/dev/null)
  if [ "$pushed" != "$head_sha" ]; then
    echo "pre-push: $local_ref is not the checked-out HEAD, so the gate cannot check it. Push it from its own checkout." >&2
    exit 1
  fi
done
[ "$has_update" -eq 1 ] || exit 0

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "pre-push: uncommitted changes; the gate would check them instead of the pushed commits. Commit or stash first." >&2
  exit 1
fi

echo "pre-push: running {{CMD_GATE}}" >&2
if ! ( {{CMD_GATE}} ); then
  echo "pre-push: quality gate failed, push blocked. Fix the failures or ask the developer." >&2
  exit 1
fi
